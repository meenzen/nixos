#!/usr/bin/env bash

set -eo pipefail

source "$(dirname "$0")/lib.sh"

# check if hostname is passed as first argument
if [ -z "$1" ]; then
    print_error "No hostname provided. Usage: $0 <hostname>"
    exit 1
fi
HOSTNAME="$1"

prompt_or_exit "Are you sure you want to install NixOS?"

print_start "Installing NixOS"

# add binary caches for faster installation
mkdir -p ~/.config/nix
sudo tee ~/.config/nix/nix.conf <<EOF
substituters = https://nix-gaming.cachix.org https://nix-community.cachix.org https://attic.mnzn.dev/main https://attic.human-dev.io/human https://nix-citizen.cachix.org https://cache.nixos.org/
trusted-public-keys = cache.nixos.org-1:6NCHdD59X431o0gWypbMrAURkbJ16ZPMQFGspcDShjY= nix-gaming.cachix.org-1:nbjlureqMbRAxR1gJ/f3hxemL9svXaZF/Ees8vCUUs4= nix-community.cachix.org-1:mB9FSh9qf2dCimDSUo8Zy7bkq5CX+/rkCWyvRCYg3Fs= main:S8Ire6opydyGvlK4PI03t1UIwFsYJqKvn6EJrY4EoNA= human:TFU+2BTCP6U2cZwUJ9iKGCJvsuRwe/alCqrN9TjgN/4= nix-citizen.cachix.org-1:lPMkWc2X8XD4/7YPEEwXKKBg+SVbYTVrAaLA2wQTKCo=
EOF

nix --experimental-features "nix-command flakes" run github:nix-community/disko/latest -- --mode destroy,format,mount "systems/$HOSTNAME/disko.nix"
sudo nixos-install -v --flake ".#${HOSTNAME}"
